# Backend environment variables for local / Render Web Service.
# Copy to a local .env only if your tooling loads it — do not commit .env files.
# Render: set these in the service Environment tab (see render.yaml).

# Absolute path to the repository root (contains data/, artifacts/, src/).
# On Render native Python this is typically /opt/render/project/src
DTL_PROJECT_ROOT=

# Comma-separated browser origins allowed to call the API (Static Site URL).
# Example: https://dtl-agent-dashboard.onrender.com
CORS_ALLOWED_ORIGINS=

LOG_LEVEL=INFO
API_PREFIX=/api/v1

# Optional: override listen host/port for local runs (Render injects PORT).
# API_HOST=0.0.0.0
# API_PORT=8000

# Render build-time runtime data (set in Render dashboard — do not commit URLs)
# RUNTIME_DATA_URL=
# RUNTIME_DATA_SHA256=
